{
	tailscale {
		auth_key {$TS_AUTHKEY}
		ephemeral
	}
}

:80 {
	bind tailscale/home-assistant
	reverse_proxy http://192.168.189.201:8123
}

https://home-assistant.merino-fish.ts.net {
	bind tailscale/home-assistant
	reverse_proxy http://olares:8123
}

localhost,
http://home.local {
	respond "Local network"
}

http://foo.home.local {
	respond "Subdomains work"
}
